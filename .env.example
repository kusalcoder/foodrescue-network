# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file to version control.

# Which config to load: development | testing | production
FLASK_ENV=development

# Flask secret key — used for session signing and (from Phase 3
# onward) for signing authentication tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret-value

# PostgreSQL connection string.
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://foodrescue_user:replace_with_password@localhost:5432/foodrescue_db

# Optional: separate database used only when running automated tests
# (Phase 12), so tests never touch real/development data.
TEST_DATABASE_URL=postgresql://foodrescue_user:replace_with_password@localhost:5432/foodrescue_test_db

# File upload settings (used starting in the optional file module).
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=5242880

# Host and port the Flask dev server listens on.
HOST=0.0.0.0
PORT=5000
